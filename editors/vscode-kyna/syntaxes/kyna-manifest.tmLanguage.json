{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kyna Manifest",
  "scopeName": "source.kyna-manifest",
  "patterns": [
    { "include": "#comment" },
    { "include": "#table" },
    { "include": "#key" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" }
  ],
  "repository": {
    "comment": { "patterns": [{ "name": "comment.line.number-sign.kyna-manifest", "match": "#.*$" }] },
    "table": { "patterns": [{ "name": "entity.name.section.kyna-manifest", "match": "^\\s*\\[+[^]\\r\\n]+\\]+" }] },
    "key": { "patterns": [{ "name": "variable.other.key.kyna-manifest", "match": "^[\\t ]*[A-Za-z_][A-Za-z0-9_.-]*(?=\\s*=)" }] },
    "string": { "patterns": [{ "name": "string.quoted.double.kyna-manifest", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.kyna-manifest", "match": "\\\\." }] }] },
    "number": { "patterns": [{ "name": "constant.numeric.kyna-manifest", "match": "(?<![A-Za-z_])[-+]?[0-9]+(?:\\.[0-9]+)?" }] },
    "boolean": { "patterns": [{ "name": "constant.language.boolean.kyna-manifest", "match": "\\b(?:true|false)\\b" }] }
  }
}
