{
  "name": "Kyna",
  "scopeName": "source.kyna",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.number-sign.kyna", "match": "#.*$" }, { "name": "comment.line.double-slash.kyna", "match": "//.*$" }, { "name": "comment.block.kyna", "begin": "/\\*", "end": "\\*/" }] },
    "strings": { "patterns": [{ "name": "string.quoted.double.kyna", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.kyna", "match": "\\\\." }] }, { "name": "constant.character.kyna", "begin": "'", "end": "'" }] },
    "numbers": { "patterns": [{ "name": "constant.numeric.float.kyna", "match": "\\b[0-9]+\\.[0-9]+\\b" }, { "name": "constant.numeric.integer.kyna", "match": "\\b[0-9]+\\b" }] },
    "keywords": { "patterns": [{ "name": "keyword.control.kyna", "match": "\\b(var|const|fn|let|set|func|return|if|else|while|loop|break|continue|switch|case|default|await|match|try|catch|finally|throw|import|export|as|new|class|extends|implements|init|self|super|intf|trait)\\b" }, { "name": "storage.modifier.kyna", "match": "\\b(public|private|protected|static|override|final|abstract)\\b" }, { "name": "constant.language.kyna", "match": "\\b(true|false|null)\\b" }] },
    "types": { "patterns": [{ "name": "support.type.primitive.kyna", "match": "\\b(int|float|num|str|char|bool|void|any)\\b" }] },
    "functions": { "patterns": [{ "name": "entity.name.function.kyna", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }] },
    "operators": { "patterns": [{ "name": "keyword.operator.kyna", "match": "(=>|==|!=|<=|>=|&&|\\|\\||[+*/%!=<>?-])" }] }
  }
}
