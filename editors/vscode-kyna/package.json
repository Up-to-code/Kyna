{
  "name": "kyna-language-support",
  "displayName": "Kyna Language Support",
  "description": "Kyna syntax, completions, live diagnostics, imports, comments, and run/check tools.",
  "version": "1.0.3",
  "publisher": "kyna-lang",
  "license": "MIT",
  "icon": "assets/kyna-k.png",
  "galleryBanner": { "color": "#6D4AFF", "theme": "dark" },
  "keywords": ["kyna", "language", "bytecode", "backend", "diagnostics"],
  "repository": { "type": "git", "url": "https://github.com/Up-to-code/Kyna.git" },
  "bugs": { "url": "https://github.com/Up-to-code/Kyna/issues" },
  "homepage": "https://github.com/Up-to-code/Kyna",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:kyna"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "kyna",
      "aliases": ["Kyna", "kyna"],
      "extensions": [".kyna"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./assets/kyna-file-light.svg",
        "dark": "./assets/kyna-file-dark.svg"
      }
    }],
    "grammars": [{
      "language": "kyna",
      "scopeName": "source.kyna",
      "path": "./syntaxes/kyna.tmLanguage.json"
    }],
    "snippets": [{
      "language": "kyna",
      "path": "./snippets/kyna.json"
    }],
    "commands": [
      {
        "command": "kyna.runFile",
        "title": "Kyna: Run File",
        "icon": {
          "light": "./assets/run-light.svg",
          "dark": "./assets/run-dark.svg"
        }
      },
      {
        "command": "kyna.checkFile",
        "title": "Kyna: Check File",
        "icon": {
          "light": "./assets/check-light.svg",
          "dark": "./assets/check-dark.svg"
        }
      },
      {
        "command": "kyna.showTokens",
        "title": "Kyna: Show Tokens"
      },
      {
        "command": "kyna.showAst",
        "title": "Kyna: Show Syntax Tree"
      },
      {
        "command": "kyna.showHir",
        "title": "Kyna: Show HIR"
      },
      {
        "command": "kyna.showMir",
        "title": "Kyna: Show MIR"
      },
      {
        "command": "kyna.showBytecode",
        "title": "Kyna: Show Bytecode"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "kyna.runFile", "when": "editorLangId == kyna", "group": "navigation@1" },
        { "command": "kyna.checkFile", "when": "editorLangId == kyna", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "Kyna",
      "properties": {
        "kyna.executable": {
          "type": "string",
          "default": "",
          "description": "Kyna executable path. Empty auto-detects build/bin/kyna and preset build directories in the workspace, then falls back to PATH."
        }
      }
    }
  }
}
