func isPrime(n: int): bool {
    if (n < 2) { return false; }
    let d = 2;
    while (d * d <= n) {
        if (n % d == 0) { return false; }
        d = d + 1;
    }
    return true;
}

func countPrimes(limit: int): int {
    let count = 0;
    let i = 2;
    while (i <= limit) {
        if (isPrime(i)) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

print(countPrimes(50000));
