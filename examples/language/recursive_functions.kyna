# Named functions are validated, lowered to bytecode, and invoked with explicit VM frames.
fn factorial(value: int): int {
    if (value <= 1) {
        return 1;
    } else {
        return value * factorial(value - 1);
    }
}

fn fibonacci(value: int): int {
    if (value <= 1) {
        return value;
    } else {
        return fibonacci(value - 1) + fibonacci(value - 2);
    }
}

const factorialSix: int = factorial(6);
const fibonacciTen: int = fibonacci(10);

# Fail loudly if call arguments, return values, recursion, or branching are incorrect.
if (factorialSix == 720) {
    if (fibonacciTen == 55) {
        const verified = true;
    } else {
        const invalidFibonacci = 1 / 0;
    }
} else {
    const invalidFactorial = 1 / 0;
}

print("factorial(6)", factorialSix);
print("fibonacci(10)", fibonacciTen);
