# Functions are values and can be passed through higher-order functions.
fn add(left: int, right: int): int {
    return left + right;
}

fn multiply(left: int, right: int): int {
    return left * right;
}

fn apply(operation: any, left: int, right: int): any {
    return operation(left, right);
}

const selected = add;
const sum = apply(selected, 20, 22);
const product = apply(multiply, 6, 7);

# Fail loudly if function references, argument transport, or indirect dispatch regress.
if (sum == 42 && product == 42) {
    const verified = true;
} else {
    const invalidFirstClassCall = 1 / 0;
}

print("sum", sum);
print("product", product);
