# Immutable const bindings, mutable var bindings, equality, and nullable values.
const answer: int = 42;
var counter: int = 0;
counter = counter + 1;
counter = counter + 1;
fn incrementCounter(): int {
    counter = counter + 1;
    return counter;
}
var nickname: str? = null;
const missing = nickname == null;
nickname = "Kyna";

print("bindings", answer, counter);
print("nullable", missing, nickname == "Kyna");
print("equality", answer == 42, answer != 41);
