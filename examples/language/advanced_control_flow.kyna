# Short-circuit booleans, mutable bindings, nested loops, and labeled exits all lower to MIR.
var visits = 0;

outer: loop (var row = 0; row < 5; row = row + 1) {
    loop (var column = 0; column < 5; column = column + 1) {
        if (column == 1) {
            continue;
        }
        if (row == 3) {
            break outer;
        }
        visits = visits + 1;
    }
}

# Neither division is evaluated: && and || are lowered as control flow, not eager operators.
const shortCircuitAnd = false && (1 / 0 == 0);
const shortCircuitOr = true || (1 / 0 == 0);

# Fail loudly if loop targets, increments, mutation, or short-circuiting regress.
if (visits == 12 && !shortCircuitAnd && shortCircuitOr) {
    const verified = true;
} else {
    const invalidControlFlow = 1 / 0;
}

print("visits", visits);
print("shortCircuit", shortCircuitAnd, shortCircuitOr);
