# Arrays and higher-order collection algorithms.
func double(value: any): any {
    return value * 2;
}

func add(total: any, value: any): any {
    return total + value;
}

func isEven(value: any): bool {
    return value % 2 == 0;
}

func isPositive(value: any): bool {
    return value > 0;
}

set input = [1, 2, 2, 3];
set mapped = map(input, double);
set total = reduce(input, add, 0);
set firstEven = find(input, isEven);
set evens = filter(input, isEven);
set distinct = unique(input);
set ordered = sort([3, 1, 2]);

print("mapped", jsonStringify(mapped));
print("reduced", total, "first", firstEven);
print("filtered", jsonStringify(evens));
print("distinct", jsonStringify(distinct));
print("ordered", jsonStringify(ordered));
print("predicates", any(input, isEven), all(input, isPositive));
