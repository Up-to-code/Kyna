# Arrays and higher-order collection algorithms.
fn double(value: any): any {
    return value * 2;
}

fn add(total: any, value: any): any {
    return total + value;
}

fn isEven(value: any): bool {
    return value % 2 == 0;
}

fn isPositive(value: any): bool {
    return value > 0;
}

const input = [1, 2, 2, 3];
const mapped = map(input, double);
const total = reduce(input, add, 0);
const firstEven = find(input, isEven);
const evens = filter(input, isEven);
const distinct = unique(input);
const ordered = sort([3, 1, 2]);

print("mapped", jsonStringify(mapped));
print("reduced", total, "first", firstEven);
print("filtered", jsonStringify(evens));
print("distinct", jsonStringify(distinct));
print("ordered", jsonStringify(ordered));
print("predicates", any(input, isEven), all(input, isPositive));
