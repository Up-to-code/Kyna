# Typed Error values, catch, closure mutation, and guaranteed cleanup.
fn demonstrateExceptions(): void {
    var trace = "";

    fn guarded(): str {
        try {
            throw "boom";
        } catch (failure) {
            trace = trace + failure.code + ":" + failure.message + ":" + failure.cause;
            return "recovered";
        } finally {
            trace = trace + ":cleanup-first";
            trace = trace + ":cleanup-second";
        }
    }

    fn returnThroughFinally(): str {
        try {
            return "returned";
        } finally {
            trace = trace + ":return-cleanup";
        }
    }

    const result = guarded();
    const returned = returnThroughFinally();
    print(result, returned, trace);
}

demonstrateExceptions();
