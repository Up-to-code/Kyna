# Nested functions capture lexical bindings by cell.
fn makeAdder(base: int): any {
    fn add(value: int): int {
        return base + value;
    }
    return add;
}

fn makeCounter(start: int): any {
    var value = start;
    fn next(): int {
        value = value + 1;
        return value;
    }
    return next;
}

fn makeFactorial(): any {
    fn factorial(value: int): int {
        if (value <= 1) {
            return 1;
        }
        return value * factorial(value - 1);
    }
    return factorial;
}

fn makeNestedAdder(base: int): any {
    fn middle(): any {
        fn inner(value: int): int {
            return base + value;
        }
        return inner;
    }
    return middle();
}

const addForty = makeAdder(40);
const firstCounter = makeCounter(0);
const secondCounter = makeCounter(10);
const factorial = makeFactorial();
const nestedAdder = makeNestedAdder(40);

const firstValue = firstCounter();
const secondValue = firstCounter();
const independentValue = secondCounter();

print("addForty", addForty(2));
print("firstCounter", firstValue, secondValue);
print("secondCounter", independentValue);
print("factorial", factorial(5));
print("nestedAdder", nestedAdder(2));
 