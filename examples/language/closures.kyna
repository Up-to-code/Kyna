# Nested functions capture lexical bindings by cell.
func makeAdder(base: int): any {
    func add(value: int): int {
        return base + value;
    }
    return add;
}

func makeCounter(start: int): any {
    let value = start;
    func next(): int {
        value = value + 1;
        return value;
    }
    return next;
}

func makeFactorial(): any {
    func factorial(value: int): int {
        if (value <= 1) {
            return 1;
        }
        return value * factorial(value - 1);
    }
    return factorial;
}

func makeNestedAdder(base: int): any {
    func middle(): any {
        func inner(value: int): int {
            return base + value;
        }
        return inner;
    }
    return middle();
}

set addForty = makeAdder(40);
set firstCounter = makeCounter(0);
set secondCounter = makeCounter(10);
set factorial = makeFactorial();
set nestedAdder = makeNestedAdder(40);

set firstValue = firstCounter();
set secondValue = firstCounter();
set independentValue = secondCounter();

print("addForty", addForty(2));
print("firstCounter", firstValue, secondValue);
print("secondCounter", independentValue);
print("factorial", factorial(5));
print("nestedAdder", nestedAdder(2));
