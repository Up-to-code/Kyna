class Animal {
    public name: str;

    public init(name: str) {
        self.name = name;
    }

    public fn speak(): str {
        return self.name;
    }
}

class Dog extends Animal {
    public override fn speak(): str {
        return "woof " + self.name;
    }
}

var pet = new Dog("Rex");
print(pet.speak());
