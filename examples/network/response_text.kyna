# Read the same response as raw text before deciding how to decode it.
try {
    const response = fetch("mock://kyna/users", { timeout: 1000 });
    const rawBody = response.text();
    const users = jsonParse(rawBody);
    print("text response", response.status, len(rawBody), users[2].name);
} catch (failure) {
    print("response failure", failure.code, failure.message);
}
