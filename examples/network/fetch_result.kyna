# Non-throwing HTTP workflow. The result always has ok, response, and error fields.
const success = http.tryFetch("mock://kyna/users", { timeout: 1000 });
if (!success.ok || success.response.status != 200 || success.error != null) {
    error("successful fetch result checkpoint failed");
}

# Invalid transport input becomes a typed Error value instead of escaping the call.
const failed = fetchResult("invalid://not-supported", { timeout: 1000 });
if (failed.ok || failed.response != null || failed.error.code != "KNET2001") {
    error("failed fetch result checkpoint failed");
}

print("safe fetch", success.response.status, success.error == null);
print("safe failure", failed.error.code, textContains(failed.error.message, "request failed"));
