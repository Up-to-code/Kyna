# Read secrets from the environment; never commit real tokens to source control.
set token = processEnv("KYNA_API_TOKEN");
if (token == null) {
    print("Set KYNA_API_TOKEN before running this example");
} else {
    try {
        set response = fetch("https://api.example.com/v1/profile", {
            timeout: 10000,
            headers: {
                Authorization: "Bearer " + token,
                Accept: "application/json"
            }
        });
        print("authorized", response.status, response.ok);
    } catch (failure) {
        print("authorization request failed", failure.code, failure.message);
    }
}
