# Run in a disposable working directory: create, read, edit, and remove TOML/XML files.
const directory = "kyna-document-files";
const tomlPath = directory + "/project.toml";
const xmlPath = directory + "/project.xml";

try {
    fs.createDirectory(directory);

    fs.write(tomlPath, toml.stringify({ title: "Draft", revision: 1 }));
    const draft = toml.parse(fs.read(tomlPath));
    fs.write(tomlPath, toml.stringify({ title: "Kyna", revision: draft.revision + 1 }));
    const edited = toml.parse(fs.read(tomlPath));

    fs.write(xmlPath, xml.stringify({
        name: "project",
        attributes: { version: "1" },
        text: "",
        children: [{ name: "name", attributes: {}, text: "Kyna", children: [] }]
    }));
    const document = xml.parse(fs.read(xmlPath));

    print("document files", edited.title, edited.revision, document.children[0].text);
    fs.remove(tomlPath);
    fs.remove(xmlPath);
    fs.remove(directory);
} catch (failure) {
    throw failure;
}
