# Run in a disposable working directory: the lesson removes everything it creates.
const directory = "kyna-learning-files";
const path = directory + "/lesson.json";

try {
    fs.createDirectory(directory);
    fs.writeJson(path, { stage: "draft", revision: 1 });
    const draft = fs.readJson(path);
    fs.writeJson(path, { stage: "published", revision: draft.revision + 1 });
    const published = fs.readJson(path);
    print("file", published.stage, published.revision, fs.exists(path));
    fs.remove(path);
    fs.remove(directory);
} catch (failure) {
    throw failure;
}
