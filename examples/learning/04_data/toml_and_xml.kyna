# Native TOML and XML modules convert documents to ordinary Kyna values.
const settings = tomlParse("title = \"Kyna\"\n[server]\nport = 8080\nenabled = true\n");
const roundTripSettings = toml.parse(tomlStringify(settings));

const project = xmlParse("<project version=\"1\"><name>Kyna</name><files count=\"2\"/></project>");
const roundTripProject = xml.parse(xmlStringify(project));

print("formats", roundTripSettings.title, roundTripSettings.server.port,
      roundTripProject.name, roundTripProject.children[0].text);
