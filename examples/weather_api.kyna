# Live HTTPS and JSON smoke test using Open-Meteo (no API key required).
fn main(): void {
    try {
        const endpoint = "https://api.open-meteo.com/v1/forecast?latitude=30.0444&longitude=31.2357&current=temperature_2m,wind_speed_10m";
        const response = fetch(endpoint, { timeout: 15000 });
        const weather = response.json();

        console.log("Open-Meteo", response.status, weather.timezone);
        console.log("temperature", weather.current.temperature_2m, "wind", weather.current.wind_speed_10m);

        createDirectory("weather-output");
        writeJsonFile("weather-output/current.json", weather);
        const saved = readJsonFile("weather-output/current.json");
        console.log("saved", saved.current.time);
    } catch (message) {
        console.log("Weather API request failed", message);
    }
}

main();
