# In-memory CRUD store.
const store = createApiStore([{ id: 1, name: "first" }]);
const initial = store.get(1);
store.create({ id: 2, name: "second" });
const updated = store.update(2, { name: "updated" });
const removed = store.remove(1);

print("store", initial.name, updated.name, removed, len(store.list()));
