# Filesystem and JSON-file operations. Run from a disposable working directory.
const directory = "kyna-filesystem-example";
const textPath = directory + "/message.txt";
const jsonPath = directory + "/metadata.json";

try {
    createDirectory(directory);
    writeFile(textPath, "Hello filesystem");
    writeJsonFile(jsonPath, { language: "Kyna", version: 1 });

    const message = readFile(textPath);
    const metadata = readJsonFile(jsonPath);
    const entries = listDirectory(directory);
    print("files", message, metadata.language, fileExists(textPath), len(entries));

    removePath(textPath);
    removePath(jsonPath);
    removePath(directory);
} catch (failure) {
    print("filesystem failure", failure.code, failure.message);
}
