// Arithmetic, recursion, arrays, and error handling.
fn factorial(n: int): int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn isPrime(n: int): bool {
    if (n < 2) {
        return false;
    }
    var divisor = 2;
    while (divisor * divisor <= n) {
        if (n % divisor == 0) {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}

var values = [1, 2, 3, 4, 5];
var total: num = 0;
loop (var i = 0; i < len(values); i = i + 1) {
    total = total + values[i];
}

console.log("5! =", factorial(5));
console.log("sum =", total);
console.log("17 prime =", isPrime(17));
try {
    error("demonstration error");
} catch (message) {
    logColor("yellow", "caught: " + message);
}
