{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "developer-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "KYNA_BUILD_TESTS": "ON",
        "KYNA_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "developer-base",
      "displayName": "Kyna Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "developer-base",
      "displayName": "Kyna Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KYNA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "developer-base",
      "displayName": "Kyna ASan and UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KYNA_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "sanitizers", "configurePreset": "sanitizers" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "output": { "outputOnFailure": true }
    }
  ]
}
